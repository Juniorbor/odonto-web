generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("VENDEDOR") // ADMIN, GERENTE, FUNCIONARIO, VENDEDOR
  permissions   String?   // JSON array of string permissions
  active        Boolean   @default(true)
  avatarUrl     String?
  phone         String?
  title         String?
  lastLoginAt   DateTime?
  lastDevice    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  passwordResets        PasswordResetToken[]
  stockMovements        StockMovement[]
  quotes                Quote[]
  sales                 Sale[]
  financialTransactions FinancialTransaction[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  details   String?
  device    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id           String    @id @default(cuid())
  fullName     String
  cpfCnpj      String?
  birthDate    DateTime?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  cep          String?
  socials      String?
  photoUrl     String?
  observations String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events                Event[]
  quotes                Quote[]
  sales                 Sale[]
  galleryImages         GalleryImage[]
  financialTransactions FinancialTransaction[]

  @@index([fullName])
  @@index([phone])
}

model Event {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  type            String   // Aniversário, Casamento, Noivado, Chá de bebê, Chá revelação, Formatura, Festa infantil, 15 Anos, Corporativo, Outros
  date            DateTime
  location        String?
  time            String?
  theme           String?
  guestsCount     Int?     @default(0)
  contractedValue Float    @default(0.0)
  status          String   @default("ORCAMENTO") // ORCAMENTO, RESERVADO, CONFIRMADO, PREPARACAO, EM_ANDAMENTO, FINALIZADO, CANCELADO
  observations    String?
  decorSummary    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotes         Quote[]
  sales          Sale[]
  decorGalleries DecorGallery[]
  galleryImages  GalleryImage[]

  @@index([clientId])
  @@index([date])
  @@index([status])
}

model DecorGallery {
  id               String   @id @default(cuid())
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title            String
  theme            String
  description      String?
  coverImage       String
  imagesJson       String?  // JSON string array
  productsUsedJson String?  // JSON string array
  totalValue       Float    @default(0.0)
  location         String?
  date             String?
  observations     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products Product[]
}

model Supplier {
  id               String   @id @default(cuid())
  companyName      String
  cnpj             String?
  contactPerson    String?
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  productsSupplied String?
  observations     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products              Product[]
  stockEntries          StockEntry[]
  financialTransactions FinancialTransaction[]
}

model Product {
  id                String   @id @default(cuid())
  code              String   @unique
  sku               String?
  name              String
  description       String?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory       String?
  brand             String?
  unit              String   @default("UN")
  costPrice         Float    @default(0.0)
  sellingPrice      Float    @default(0.0)
  currentStock      Int      @default(0)
  minStock          Int      @default(0)
  maxStock          Int      @default(100)
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location          String?
  mainPhoto         String?
  photoGalleryJson  String?  // JSON array of image URLs
  observations      String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockMovements StockMovement[]
  quoteItems     QuoteItem[]
  saleItems      SaleItem[]

  @@index([name])
  @@index([code])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  type          String   // ENTRADA, SAIDA, AJUSTE, TRANSFERENCIA, RESERVA, DEVOLUCAO, PERDA, AVARIA
  date          DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason        String?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([date])
}

model StockEntry {
  id            String    @id @default(cuid())
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber String?
  date          DateTime  @default(now())
  totalValue    Float     @default(0.0)
  paymentMethod String?
  itemsJson     String?   // JSON array
  notes         String?
  userId        String?
  createdAt     DateTime  @default(now())
}

model StockExit {
  id         String   @id @default(cuid())
  reason     String   // Venda, Evento, Perda, Avaria, Uso interno, Devolução, Ajuste
  date       DateTime @default(now())
  totalValue Float    @default(0.0)
  itemsJson  String?  // JSON array
  notes      String?
  userId     String?
  createdAt  DateTime @default(now())
}

model Quote {
  id           String    @id @default(cuid())
  code         String    @unique
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  subtotal     Float     @default(0.0)
  servicesFee  Float     @default(0.0)
  transportFee Float     @default(0.0)
  laborFee     Float     @default(0.0)
  assemblyFee  Float     @default(0.0)
  discount     Float     @default(0.0)
  totalValue   Float     @default(0.0)
  status       String    @default("ORCAMENTO") // ORCAMENTO, APROVADO, REJEITADO, CANCELADO
  validityDate DateTime?
  notes        String?
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items QuoteItem[]
  sales Sale[]

  @@index([clientId])
  @@index([code])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  totalPrice  Float    @default(0.0)

  @@index([quoteId])
}

model Sale {
  id            String    @id @default(cuid())
  code          String    @unique
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  eventId       String?
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  subtotal      Float     @default(0.0)
  discount      Float     @default(0.0)
  totalValue    Float     @default(0.0)
  paidAmount    Float     @default(0.0)
  pendingAmount Float     @default(0.0)
  paymentMethod String?   // Dinheiro, PIX, Cartão de Débito, Cartão de Crédito, Transferência, Outros
  installments  Int       @default(1)
  status        String    @default("PAGO") // PAGO, PARCIAL, PENDENTE, CANCELADO
  date          DateTime  @default(now())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items                 SaleItem[]
  financialTransactions FinancialTransaction[]

  @@index([clientId])
  @@index([code])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  totalPrice  Float    @default(0.0)

  @@index([saleId])
}

model FinancialTransaction {
  id            String    @id @default(cuid())
  type          String    // RECEITA, DESPESA
  category      String
  description   String
  amount        Float     @default(0.0)
  dueDate       DateTime  @default(now())
  paymentDate   DateTime?
  status        String    @default("PENDENTE") // PAGO, PENDENTE, VENCIDO, CANCELADO
  paymentMethod String?
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  notes         String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([dueDate])
}

model GalleryImage {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  albumName String   @default("Geral")
  title     String?
  url       String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([eventId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  message   String
  type      String   // STOCK_LOW, OUT_OF_STOCK, NEW_QUOTE, QUOTE_APPROVED, PENDING_PAYMENT, UPCOMING_EVENT, OVERDUE_BILL, NEW_CLIENT, SYSTEM
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model CompanySettings {
  id            String   @id @default("default")
  companyName   String   @default("OdontoWeb Consultório Odontológico")
  slogan        String   @default("Gestão e Atendimento Odontológico Avançado")
  cnpj          String?  @default("12.345.678/0001-99")
  phone         String?  @default("(11) 98888-7777")
  whatsapp      String?  @default("(11) 98888-7777")
  email         String?  @default("contato@odontoweb.com.br")
  address       String?  @default("Av. Paulista, 1000 - São Paulo, SP")
  logoUrl       String   @default("/logo.jpg")
  primaryColor  String   @default("#0D9488")
  secondaryColor String  @default("#0284C7")
  accentColor   String   @default("#F59E0B")
  themeMode     String   @default("dark")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
